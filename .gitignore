# Configuración sensible: los archivos reales de entorno nunca se versionan
.env
.env.*
!.env.example
!.env.*.example

# Bases de datos y copias de seguridad locales
*.sqlite
*.sqlite3
*.db
*.bak
*.backup
*.dump
*.sql

# Claves privadas, certificados y almacenes de credenciales
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore

# Archivos generados automáticamente por Python
__pycache__/
*.pyc
*.pyo

# Archivos estáticos y multimedia generados
/staticfiles/

# Dependencias de Node; el CSS compilado sí se versiona
/node_modules/
