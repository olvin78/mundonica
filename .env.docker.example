# Copia este archivo a .env.docker y ajusta los valores
DJANGO_SECRET_KEY=cambia-esta-clave-secreta-en-produccion
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,mundonica.org,www.mundonica.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://mundonica.org,https://www.mundonica.org,http://localhost,http://localhost:8001,http://127.0.0.1,http://127.0.0.1:8001
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SESSION_COOKIE_SECURE=true

# Correo transaccional Brevo. No guardes la clave en el repositorio.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=tu_login_smtp_de_brevo
EMAIL_HOST_PASSWORD=tu_clave_smtp_de_brevo
DEFAULT_FROM_EMAIL=info@mundonica.org
HISTORIAS_NOTIFICATION_EMAIL=euskodev@gmail.com
RECAPTCHA_PRIVATE_KEY=tu_clave_privada_de_recaptcha
